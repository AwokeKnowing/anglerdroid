# Copy to .env and fill in your values:
#   cp .env.example .env

# Camera serials (from rs-enumerate-devices or lsusb)
RS1_SERIAL=815412070676
RS2_SERIAL=944622074292
RGB_DEVICE=/dev/video0

# SLAM backend: "self" (wheel+visual odom) or "cuvslam" (NVIDIA cuVSLAM)
SLAM_BACKEND=cuvslam

# Gemini API key (optional)
GEMINI_KEY=

# L4T base image — match to your JetPack version
#   JP 6.0 GA: nvcr.io/nvidia/l4t-jetpack:r36.3.0
#   JP 6.1:    nvcr.io/nvidia/l4t-jetpack:r36.4.0
#   JP 6.2:    nvcr.io/nvidia/l4t-jetpack:r36.4.0  (closest available tag)
BASE_IMAGE=nvcr.io/nvidia/l4t-jetpack:r36.4.0

# Server ports
HTTP_PORT=8080
WS_PORT=8081
