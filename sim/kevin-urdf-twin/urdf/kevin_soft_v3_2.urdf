  <joint name="dustpan_flap_joint" type="revolute">
    <parent link="dustpan_base"/><child link="dustpan_flap"/>
    <!-- v259 (James): closed pose rotated +2.1 deg about the hinge axis (+Y = opening sense) so the lip clears the two
         bracket_top_front_inner_t T's + bolt heads on the front face of beam_top_front. q=0 is still "closed";
         the upper limit is reduced by the same 2.1 deg so the fully-open (lip flat on the floor) pose is unchanged. -->
    <origin xyz="0 0 0" rpy="0 0.036652 0"/>
    <!-- +Y: positive q swings the flap up/forward/down (opens like a dustpan) -->
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="3.0548" effort="1.0" velocity="2.0"/>
    <dynamics damping="0.005" friction="0.02"/>
  </joint>

