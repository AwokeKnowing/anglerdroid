  <!-- ===== ReSpeaker USB Mic Array (Seeed XVF-3000 "USB 4-Mic Array v2.0", black moulded case), v232 =====
       Real part: Seeed case drawing refs/seeed/respeaker/dimension.pdf + wiki "Hardware Overview"
       (refs/seeed/respeaker/hw_overview.png, wiki.seeedstudio.com/ReSpeaker_Mic_Array_v2.0):
         case Ø77.6 x 13.0 mm (bare board Ø70), top-edge round R3.2, bottom R1.0, light-ring band at R27.4,
         4 mic holes Ø1.5 on a 45.7 mm square (r 32.3 mm), micro-USB + 3.5 mm jack on the side, 12 RGB LEDs.
       Visual: meshes/respeaker_body.stl + 12 x meshes/respeaker_led_segment.stl (meshes/gen_respeaker.py);
       this block is written by meshes/gen_respeaker_urdf.py. Collision stays a plain cylinder.
       Mount: base sits on the tip crossbeam + top corner cube (top faces z = 0.9075), so the puck centre is
       z = 0.9075 + 0.0065 = 0.914 (v231: Ø75x15 disc at z 0.915, resized to the datasheet, same x/y, same base).
       Ports (micro-USB, jack) face robot REAR (-X) - assumed cable run toward the mast.

       ANGLE CONVENTION (REP-103): robot azimuth phi is about +Z of respeaker_array (axes parallel to base_link),
       phi = 0 = robot forward (+X), counter-clockwise positive seen from above (phi = +90 deg = robot left).
       Seeed board DOA convention (DOAANGLE / hardware overview, CCW seen from the LED side):
         board 0 = LED edge 90 deg CCW from the USB edge, board 270 = USB edge.  With the USB edge facing -X:
           phi = board_DOA - 90 deg      (firmware DOAANGLE -> respeaker_doa_joint = radians(DOAANGLE - 90))
       Real layout (board DOA -> phi):
         MIC1  45 -> -45 (front-right)   MIC2 135 ->  45 (front-left)
         MIC3 225 -> 135 (rear-left)     MIC4 315 -> 225 (rear-right)
         LED k at board DOA 30*k -> phi = 30*k - 90 deg, k = 0..11 CCW, r ~27 mm under the ring light guide.
         LED 00 sits BETWEEN mics (midway MIC4|MIC1, robot right, phi -90); every mic sits midway between two
         LEDs (MIC1 between LED01/LED02). LED 03 = forward, 06 = left, 09 = rear (above the USB).
         Positions are from the Seeed overview photo (LEDs visibly at DOA 0/30/60/90...). The customize()
         byte order (pixel_ring cmd 6, [r,g,b,0]*12) is assumed to be LED k = board DOA 30k, CCW, matching
         Seeed's DOA->LED mapping (pixel_ring position = round(angle/30)); not stated explicitly by Seeed. -->
  <link name="respeaker">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/respeaker_body.stl?v=304" scale="1 1 1"/></geometry>
      <material name="respeaker"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0388" length="0.013"/></geometry>
    </collision>
    <!-- ~50 g (board + case), solid cylinder r 38.8 mm, h 13 mm -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1.952e-5" ixy="0" ixz="0" iyy="1.952e-5" iyz="0" izz="3.764e-5"/>
    </inertial>
  </link>
  <joint name="respeaker_joint" type="fixed">
    <parent link="base_link"/><child link="respeaker"/>
    <origin xyz="-0.048 0 0.914" rpy="0 0 0"/>
  </joint>

  <!-- Mic-plane centre (array acoustic centre): on the puck axis, ~2 mm below the top face (approx.) -->
  <link name="respeaker_array"/>
  <joint name="respeaker_array_joint" type="fixed">
    <parent link="respeaker"/><child link="respeaker_array"/>
    <origin xyz="0 0 0.0045" rpy="0 0 0"/>
  </joint>

  <!-- Direction of arrival: continuous yaw about +Z of respeaker_array.
       q = DOA heading phi [rad]: 0 = robot forward (+X), CCW positive (pi/2 = left); respeaker_doa +X points
       at the sound source. From the device: q = radians(DOAANGLE - 90). Tiny inertial keeps it in physics sims. -->
  <link name="respeaker_doa">
    <inertial><mass value="0.0001"/><inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/></inertial>
  </link>
  <joint name="respeaker_doa_joint" type="continuous">
    <parent link="respeaker_array"/><child link="respeaker_doa"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <!-- Microphones (ST MP34DT01 MEMS), r = 32.3 mm: respeaker_mic_N = Seeed MICN = raw channel N (6-ch fw),
       phi = board DOA (45 + 90*(N-1)) - 90. Frame +X radially outward. -->
  <link name="respeaker_mic_1"/>
  <joint name="respeaker_mic_1_joint" type="fixed">
    <parent link="respeaker_array"/><child link="respeaker_mic_1"/>
    <origin xyz="0.02284 -0.02284 0" rpy="0 0 -0.785398"/>
  </joint>
  <link name="respeaker_mic_2"/>
  <joint name="respeaker_mic_2_joint" type="fixed">
    <parent link="respeaker_array"/><child link="respeaker_mic_2"/>
    <origin xyz="0.02284 0.02284 0" rpy="0 0 0.785398"/>
  </joint>
  <link name="respeaker_mic_3"/>
  <joint name="respeaker_mic_3_joint" type="fixed">
    <parent link="respeaker_array"/><child link="respeaker_mic_3"/>
    <origin xyz="-0.02284 0.02284 0" rpy="0 0 2.356194"/>
  </joint>
  <link name="respeaker_mic_4"/>
  <joint name="respeaker_mic_4_joint" type="fixed">
    <parent link="respeaker_array"/><child link="respeaker_mic_4"/>
    <origin xyz="-0.02284 -0.02284 0" rpy="0 0 3.926991"/>
  </joint>
  <!-- Light ring: 12 real LEDs, respeaker_led_NN = hardware LED NN at board DOA 30*NN, phi = 30*NN - 90 deg
       (00 = robot right, 03 = forward, 06 = left, 09 = rear), CCW. Origin on the ring centre-line at the
