      <geometry><box size="0.032 0.034 0.0016"/></geometry>
      <material name="odrive_board"/>
    </visual>
    <!-- green 4-pos CAN screw terminal (+Y end of length) -->
    <visual>
      <origin xyz="0 0.0155 0.0045" rpy="0 0 0"/>
      <geometry><box size="0.020 0.0085 0.010"/></geometry>
      <material name="odrive_term"/>
    </visual>
    <!-- USB-C receptacle (−Y end); silver shell ~9×7×3.5 mm class -->
    <visual>
