      <origin xyz="0.004 0 0" rpy="0 1.5707963267948966 0"/>
      <geometry><cylinder radius="0.0004" length="0.008"/></geometry>
      <material name="estop_red"/>
    </visual>
    <visual>
      <origin xyz="0 0.004 0" rpy="1.5707963267948966 0 0"/>
