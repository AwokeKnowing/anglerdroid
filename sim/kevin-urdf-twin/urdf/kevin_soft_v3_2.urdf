  <!-- ODrive shop USB-CAN Adapter (CANable-class), centered on starboard odrive_right aft/cover face.
       Product: https://shop.odriverobotics.com/products/usb-can-adapter
       Datasheet mech (with case): Width 36.14 × Length 40.16 × Height 13.65 mm
         https://docs.odriverobotics.com/v/latest/hardware/usb-can-datasheet.html
       Layout from shop pinout photo: USB-C on one short end, green 4-pos screw terminal on opposite,
       optional JST-GH + status LEDs under clear acrylic top / black base sandwich.
       Local before joint yaw: X=width, Y=length (green at +Y), Z=height (out of cover).
       Joint yaw −90° points green down (world −Z). Bottom on cover outer face z=0.025. -->
  <link name="canable">
    <!-- black case base (full footprint) -->
    <visual>
      <origin xyz="0 0 -0.0020" rpy="0 0 0"/>
      <geometry><box size="0.03614 0.04016 0.00965"/></geometry>
      <material name="canable_case"/>
