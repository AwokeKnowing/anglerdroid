  </joint>

  <!-- ========== USB16MP01 RGB board camera (tip of beam_mast_top) ==========
       32×32×1.6 mm PCB; lens stack ~25 mm PCB-front→glass; plastic velcro to tip face.
       Board vertical (YZ), lens +X; connector on PCB back at top. Sits on D435 top overhang.
       Photos: meshes/ref/rgb_cam_*.jpg -->
  <link name="rgb_camera">
    <!-- Plastic velcro pad: 2.5 mm thick, 25 mm L-R × 15 mm tall (matches tip-face
         height so it does not poke into D435 below); JST at PCB top-back stays clear -->
    <visual>
      <origin xyz="-0.00205 0 -0.0055" rpy="0 0 0"/>
      <geometry><box size="0.0025 0.025 0.015"/></geometry>
      <material name="velcro_black"/>
    </visual>
    <!-- PCB 32×32×1.6 mm (X = thickness) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.0016 0.032 0.032"/></geometry>
      <material name="pcb_brown"/>
    </visual>
    <!-- Corner mounting holes Ø2 mm, ~2.5 mm in from edges -->
    <visual>
      <origin xyz="0 0.0135 0.0135" rpy="0 1.5707963267948966 0"/>
      <geometry><cylinder radius="0.001" length="0.0018"/></geometry>
      <material name="mount_hole"/>
    </visual>
    <visual>
      <origin xyz="0 -0.0135 0.0135" rpy="0 1.5707963267948966 0"/>
      <geometry><cylinder radius="0.001" length="0.0018"/></geometry>
      <material name="mount_hole"/>
    </visual>
    <visual>
      <origin xyz="0 0.0135 -0.0135" rpy="0 1.5707963267948966 0"/>
      <geometry><cylinder radius="0.001" length="0.0018"/></geometry>
      <material name="mount_hole"/>
    </visual>
    <visual>
      <origin xyz="0 -0.0135 -0.0135" rpy="0 1.5707963267948966 0"/>
      <geometry><cylinder radius="0.001" length="0.0018"/></geometry>
      <material name="mount_hole"/>
    </visual>
    <!-- Black square lens holder ~20×20×8.5 mm -->
    <visual>
      <origin xyz="0.00505 0 0" rpy="0 0 0"/>
      <geometry><box size="0.0085 0.020 0.020"/></geometry>
      <material name="lens_black"/>
    </visual>
    <!-- Side ear tabs (mount screws) L/R -->
    <visual>
      <origin xyz="0.00505 0.0125 0" rpy="0 0 0"/>
      <geometry><box size="0.0085 0.005 0.006"/></geometry>
      <material name="lens_black"/>
    </visual>
    <visual>
      <origin xyz="0.00505 -0.0125 0" rpy="0 0 0"/>
      <geometry><box size="0.0085 0.005 0.006"/></geometry>
      <material name="lens_black"/>
    </visual>
    <!-- Ribbed/knurled barrel Ø14 × 10 mm (smooth cylinder stand-in) -->
    <visual>
      <origin xyz="0.0143 0 0" rpy="0 1.5707963267948966 0"/>
      <geometry><cylinder radius="0.007" length="0.010"/></geometry>
      <material name="lens_black"/>
    </visual>
    <!-- Wider lens front/cap Ø16.5 × 6.5 mm -->
    <visual>
      <origin xyz="0.02255 0 0" rpy="0 1.5707963267948966 0"/>
      <geometry><cylinder radius="0.00825" length="0.0065"/></geometry>
      <material name="lens_black"/>
    </visual>
    <!-- Glass (dark purple-ish) at lens front -->
    <visual>
      <origin xyz="0.0259 0 0" rpy="0 1.5707963267948966 0"/>
      <geometry><cylinder radius="0.007" length="0.0008"/></geometry>
      <material name="lens_glass"/>
    </visual>
    <!-- White 4-pin JST-style connector on PCB BACK at TOP edge -->
    <visual>
      <origin xyz="-0.0038 -0.006 0.012" rpy="0 0 0"/>
      <geometry><box size="0.006 0.010 0.0055"/></geometry>
      <material name="jst_white"/>
    </visual>
    <collision>
      <origin xyz="0.012 0 0" rpy="0 0 0"/>
      <geometry><box size="0.028 0.032 0.032"/></geometry>
    </collision>
    <inertial>
      <mass value="0.012"/>
      <origin xyz="0.008 0 0"/>
      <inertia ixx="2e-6" ixy="0" ixz="0" iyy="3e-6" iyz="0" izz="3e-6"/>
    </inertial>
  </link>
  <joint name="rgb_camera_joint" type="fixed">
    <parent link="beam_mast_top"/><child link="rgb_camera"/>
    <!-- Tip face of 150 mm top bar at world x=0; velcro 2.5 mm then PCB.
         v281: board moved down 3 mm (joint z 0.0085 -> 0.0055); PCB bottom z=0.8745 rests on D435 top; velcro pad kept at the tip (local z -0.0085 -> -0.0055 cancels the move).
         Relative to beam_mast_top center (-0.075, 0, 0.885). -->
    <origin xyz="0.0783 0 0.0055" rpy="0 0 0"/>
  </joint>
  <!-- Optical frame at lens front: +Z out of lens (+X robot), +X right, +Y down -->
  <link name="rgb_camera_optical"/>
  <joint name="rgb_camera_optical_joint" type="fixed">
    <parent link="rgb_camera"/><child link="rgb_camera_optical"/>
    <origin xyz="0.0258 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
  </joint>

  <!-- ========== DUSTPAN (James's recovered Sculpteo part faAqgw7x "angler-gripperprintv2parallel-3", matte black PLA) ========== -->
  <!-- dustpan_base = mesh part2/label1 (short lower plate, 2 T-tabs + 2 hinge knuckles). dustpan_flap = mesh part1/label0 (long flap + ~38 mm bent lip, 3 knuckles + pin + end caps; 8x8 mm zero-thickness disc removed). -->
  <!-- Both link frames: origin ON the hinge (knuckle) axis, axes parallel to base_link. Hinge world = (0.107515, 0, 0.0045015). -->
  <!-- Base fit: tab key rails (2.05-2.36 mm wide, 3.0 mm deep, 14.55 mm long) drop vertically into the TOP slot of beam_base_front (centered on x=0.1075);
       7.5 mm tab feet sit flush on the beam top (z=-0.0075) -> part pitched 16.85 deg; rear plate edge 0.62 mm in front of beam_axle_top front face (x=+0.0075). -->
  <!-- (v258 geometry, before the v259 +2.1 deg closed offset) Flap q=0 (closed): lip rear tip ~0.1 mm from the FRONT face of beam_top_front (battery-cage top front 300), lip 2.87 deg off horizontal (tip up).
       Exactly-horizontal lip would intersect beam_top_front by 1.65 mm x 4.5 mm (lip too long/high for this hinge). -->
  <!-- Flap q=upper (177.13 deg absolute = 175.03 deg from the v259 closed pose): lip exactly horizontal, face-down, 0.49 mm above the floor (z=-0.08565); heel touches floor ~0.24 deg later.
       MISMATCH: in the recovered mesh the flap root hits the base tab stems (y=+/-52.5..55.3 mm) from q=167.6 deg (lip heel then 15.4 mm above floor, lip 9.5 deg off flat);
       at q=upper the stems overlap the flap by ~6 mm^3 (1.6 x 2.3 mm local). Upper limit kept at the lip-flat angle as specified; physical print stop = 2.9252 rad. -->
  <link name="dustpan_base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/dustpan_base.stl?v=304" scale="1 1 1"/></geometry>
