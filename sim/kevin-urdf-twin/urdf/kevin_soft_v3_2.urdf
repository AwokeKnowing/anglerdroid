      <geometry><box size="0.0090 0.0070 0.0035"/></geometry>
      <material name="canable_usb"/>
    </visual>
    <!-- v242: JST BM04B-GHS-TBT top-entry CAN header (VBUS CANH CANL GND, GND toward +X), repositioned from the shop pinout
         photo: 11 mm inboard of the green terminal, offset 3.5 mm toward its GND end; 8.25 incl. tabs x 4.25 x 4.25 mm tall
         (JST eGH.pdf) on the PCB top (z 0.0033); open through a window in the clear top. -->
    <visual>
