<?xml version="1.0"?>
<!--
  Kevin MakerBeam XL differential-drive robot (v1 digital twin)
  Units: meters. Beams: MakerBeam XL 0.015 x 0.015 m, STOCK LENGTHS ONLY
  (0.300, 0.200, 0.150, 0.100, 0.050 m). Frame: x forward, y left, z up (REP-103).

  Base geometry (James hard constraints):
  - Frame width 300 mm (front/rear cross beams = 300 mm stock along Y)
  - Wheel mount faces at y = +/- 0.153 (track at hubs ~306 mm; tire centers outboard)
  - Longitudinal sides = 100 mm + 150 mm end-to-end (total 250 mm)
  - Four sets of 150+100: left/right on lower AND upper tiers (8 beams)
  - Orientation assumption (easy to flip): along +X, 100 mm FORWARD of axle
    join, 150 mm AFT of axle join. Axle at the 100|150 join (x = 0).
  - 150+100 rails are SANDWICHED BETWEEN the front & rear 300 mm end-caps
    (butt against inner faces). Join style: 300s = outside end-caps.
  - Inner span (rail length) = 250 mm; outer length = 250 + 2*15 = 280 mm.
  - Front outer face ≈ +0.115 m; rear outer face ≈ -0.165 m.
  - Front inner face / rail front end = +0.100 m; rear inner = -0.150 m.
  - Mast (James): 3x300 mm = 900 mm on aft 300 centerline (x=-0.150, y=0);
    150 mm top bar beside mast (tops flush, +7.5mm forward vs centered-on-top); T-bracket center hole on mast top center; tip plumb with drive-wheel centerline (x=0).

  Wheel mounts (v4 — James photo bracket orientation):
  - MakerBeam XL flat L-brackets (James drawing, NOT 10mm MakerBeam):
      legs 15 mm wide, long ~60 mm UP (3 holes: small / M6 / small), short ~30 mm
      on rail (2 T-slot bolts); plate thickness 1.5 mm (James).
  - Orientation: LONG leg vertical (up); SHORT leg horizontal on outer face of
      side rail, pointing AWAY from pair partner along beam (X). Verticals toward
      pair center, parallel. Big (M6) holes on uprights bolt to BotWheel flange.
  - Two L-brackets per wheel; M6 centers 36 mm apart (opposite BotWheel holes / PCD Ø36)
      BotWheel T/B diamond stay on x=0 at z=±0.018 (36 mm PCD) — see README.
  - BotWheel hub motor: Ø171 x ~0.052 m tire bulk sits OUTBOARD of mount face.
      Mount face / tire inner ≈ ±0.153 (clears beam+bracket).
      Left tire world Y: +0.153 .. +0.205; right: −0.153 .. −0.205.
  - beam_axle_top: 300 mm cross member one hole above top-diamond (z=+0.033) via T-brackets.
  - Bracket plates sit in stand-off gap: beam outer ±0.150 → plate → tire inner ±0.153.
-->
<!-- Visual: all beam_* boxes shortened 1mm on long axis (0.5mm/end) for visible seams; centers stay on true stock grid. -->
<robot name="kevin">

  <material name="beam_black"><color rgba="0.094 0.094 0.102 1"/></material>
  <material name="bracket_silver"><color rgba="0.788 0.800 0.816 1"/></material>
  <material name="bolt_steel"><color rgba="0.706 0.722 0.741 1"/></material> <!-- fb258 -->
  <material name="hole_black"><color rgba="0.020 0.020 0.022 1"/></material> <!-- fb258 -->
  <material name="foam_grey"><color rgba="0.07 0.07 0.075 1"/></material> <!-- fb258 -->
  <material name="wheel_tire"><color rgba="0.082 0.082 0.082 1"/></material>
  <material name="wheel_hub"><color rgba="0.10 0.10 0.105 1"/></material>
  <material name="battery_green"><color rgba="0.15 0.55 0.25 1"/></material>
  <material name="seeed_green"><color rgba="0.25 0.72 0.35 1"/></material>
  <material name="odrive_clear"><color rgba="0.75 0.85 0.95 0.55"/></material>
  <material name="odrive_board"><color rgba="0.08 0.08 0.09 1"/></material>
  <material name="hs_alum"><color rgba="0.72 0.74 0.76 1"/></material>
  <material name="aluminium"><color rgba="0.75 0.75 0.78 1"/></material>
  <material name="hs_black"><color rgba="0.12 0.12 0.13 1"/></material>
  <material name="odrive_pad"><color rgba="0.2 0.2 0.22 1"/></material>
  <material name="odrive_cap"><color rgba="0.72 0.74 0.76 1"/></material>
  <material name="odrive_term"><color rgba="0.22 0.62 0.28 1"/></material>
  <material name="odrive_housing"><color rgba="0.55 0.55 0.58 0.90"/></material>
  <material name="odrive_white"><color rgba="0.92 0.92 0.94 0.90"/></material>
  <material name="pc_black"><color rgba="0.08 0.08 0.1 1"/></material>
  <material name="recomputer_green"><color rgba="0.45 0.78 0.2 1"/></material>
  <material name="recomputer_metal"><color rgba="0.74 0.76 0.78 1"/></material>
  <material name="recomputer_terminal_green"><color rgba="0.18 0.62 0.31 1"/></material>
  <material name="heatsink"><color rgba="0.55 0.58 0.62 1"/></material>
  <material name="estop_red"><color rgba="0.9 0.15 0.1 1"/></material>
  <material name="respeaker"><color rgba="0.12 0.12 0.14 1"/></material>
  <material name="respeaker_ring"><color rgba="0.86 0.87 0.88 1"/></material>
  <material name="speaker"><color rgba="0.04 0.04 0.045 1"/></material>
  <material name="holder_black"><color rgba="0.10 0.10 0.105 1"/></material>
  <material name="screen_bezel"><color rgba="0.08 0.08 0.085 1"/></material>
  <material name="screen_panel"><color rgba="0.12 0.18 0.28 1"/></material>
  <material name="rs_aluminum"><color rgba="0.48 0.48 0.50 1"/></material>
  <material name="rs_ir_lens"><color rgba="0.05 0.05 0.06 1"/></material>
  <material name="rs_rgb_lens"><color rgba="0.08 0.10 0.14 1"/></material>
  <material name="rs_projector"><color rgba="0.15 0.12 0.05 1"/></material>
  <material name="rs_imu_badge"><color rgba="0.2 0.45 0.85 1"/></material>
  <material name="rs_front_glass"><color rgba="0.02 0.02 0.025 1"/></material>
  <material name="rs_label"><color rgba="0.55 0.56 0.58 1"/></material>
  <material name="rs_usb_steel"><color rgba="0.75 0.77 0.80 1"/></material>
  <material name="rs_usb_tongue"><color rgba="0.03 0.03 0.035 1"/></material>
  <material name="rs_usb_gold"><color rgba="0.80 0.63 0.25 1"/></material>
  <material name="whibal_grey"><color rgba="0.46 0.46 0.46 1"/></material>
  <material name="whibal_white"><color rgba="0.95 0.95 0.95 1"/></material>
  <material name="whibal_black"><color rgba="0.05 0.05 0.05 1"/></material>
  <material name="gate_caster_tread"><color rgba="0.42 0.42 0.44 1"/></material>
  <material name="gate_caster_rim"><color rgba="0.92 0.92 0.94 1"/></material>
  <material name="gate_caster_hub"><color rgba="0.55 0.32 0.18 1"/></material>
  <material name="estop_orange"><color rgba="0.95 0.45 0.1 1"/></material>
  <material name="caster_wheel"><color rgba="0.2 0.2 0.22 1"/></material>
  <material name="caster_bracket"><color rgba="0.65 0.65 0.68 1"/></material>
  <material name="mount_hole"><color rgba="0.05 0.05 0.06 1"/></material>
  <material name="spoke_metal"><color rgba="0.45 0.48 0.52 1"/></material>
  <material name="anker_matte"><color rgba="0.04 0.04 0.05 1"/></material>
  <material name="anker_gloss"><color rgba="0.04 0.04 0.05 1"/></material>
  <material name="usb_blue"><color rgba="0.15 0.35 0.85 1"/></material>
  <material name="led_green"><color rgba="0.15 0.85 0.25 1"/></material>
  <material name="anker_white"><color rgba="0.92 0.92 0.94 1"/></material>
  <material name="canable_case"><color rgba="0.06 0.06 0.07 1"/></material>
  <material name="canable_clear"><color rgba="0.82 0.88 0.94 0.90"/></material>
  <material name="canable_usb"><color rgba="0.72 0.74 0.76 1"/></material>
  <material name="pcb_brown"><color rgba="0.18 0.10 0.06 1"/></material>
  <material name="lens_black"><color rgba="0.06 0.06 0.07 1"/></material>
  <material name="lens_glass"><color rgba="0.12 0.18 0.28 1"/></material>
  <material name="jst_white"><color rgba="0.92 0.92 0.94 1"/></material>
  <material name="velcro_black"><color rgba="0.08 0.08 0.09 1"/></material>
  <material name="dustpan_matte_black"><color rgba="0.110 0.110 0.118 1"/></material>

  <!-- base_link: origin at drive-wheel rotation center (between middle M6s), axle join at x=0; beams at z=-0.015 -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.01 0.01 0.01"/></geometry>
      <material name="beam_black"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Cage: 4x100 mm posts. Front at x=-0.015 (flush with aft face of beam_axle_top; ~130 mm ahead of rear posts); rear at x=-0.1425 (fully on side bars, clear of rear 300) (end of side bars, 15 mm forward of base outer back, flush with sides y=±0.1425) so rear base 300 stays clear for the mast. -->
  <!-- ========== BASE CAGE — LOWER TIER (z=0) ========== -->
  <!-- 300 mm front/rear = OUTSIDE end-caps (define 300 mm width along Y). -->
  <!-- 100(fwd)+150(aft) rails SANDWICHED between inner faces of those 300s. -->
  <!-- Side beam centers at y = +/- 0.1425 (outer face-to-face width 0.300 m). -->
  <!-- Rail X span (inner): -0.150 .. +0.100 ; axle join at x=0. -->
  <!-- Outer X: rear face -0.165 .. front face +0.115 (280 mm overall). -->

  <!-- Lower left: 100 mm forward of axle -->
  <link name="beam_base_left_fwd">
    <visual>
      <!-- MakerBeam XL 15x15 T-slot profile, 99 mm (extruded along mesh X; cut ends = bare aluminium in viewer) -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/makerbeam_xl_099.stl?v=304" scale="1 1 1"/></geometry>
      <material name="beam_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.099 0.015 0.015"/></geometry>
    </collision>
    <inertial>
      <mass value="0.04"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00004" iyz="0" izz="0.00004"/>
    </inertial>
  </link>
  <joint name="beam_base_left_fwd_joint" type="fixed">
    <parent link="base_link"/><child link="beam_base_left_fwd"/>
    <origin xyz="0.05 0.1425 -0.015" rpy="0 0 0"/>
  </joint>

  <!-- Lower left: 150 mm aft of axle -->
  <link name="beam_base_left_aft">
    <visual>
      <!-- MakerBeam XL 15x15 T-slot profile, 149 mm (extruded along mesh X; cut ends = bare aluminium in viewer) -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/makerbeam_xl_149.stl?v=304" scale="1 1 1"/></geometry>
      <material name="beam_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.149 0.015 0.015"/></geometry>
    </collision>
    <inertial>
      <mass value="0.06"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00012" iyz="0" izz="0.00012"/>
    </inertial>
  </link>
  <joint name="beam_base_left_aft_joint" type="fixed">
    <parent link="base_link"/><child link="beam_base_left_aft"/>
    <origin xyz="-0.075 0.1425 -0.015" rpy="0 0 0"/>
  </joint>

  <!-- Lower right: 100 mm forward -->
  <link name="beam_base_right_fwd">
    <visual>
      <!-- MakerBeam XL 15x15 T-slot profile, 99 mm (extruded along mesh X; cut ends = bare aluminium in viewer) -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/makerbeam_xl_099.stl?v=304" scale="1 1 1"/></geometry>
      <material name="beam_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.099 0.015 0.015"/></geometry>
    </collision>
    <inertial>
      <mass value="0.04"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00004" iyz="0" izz="0.00004"/>
    </inertial>
  </link>
  <joint name="beam_base_right_fwd_joint" type="fixed">
    <parent link="base_link"/><child link="beam_base_right_fwd"/>
    <origin xyz="0.05 -0.1425 -0.015" rpy="0 0 0"/>
  </joint>

  <!-- Lower right: 150 mm aft -->
  <link name="beam_base_right_aft">
    <visual>
      <!-- MakerBeam XL 15x15 T-slot profile, 149 mm (extruded along mesh X; cut ends = bare aluminium in viewer) -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/makerbeam_xl_149.stl?v=304" scale="1 1 1"/></geometry>
      <material name="beam_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.149 0.015 0.015"/></geometry>
    </collision>
    <inertial>
      <mass value="0.06"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00012" iyz="0" izz="0.00012"/>
    </inertial>
  </link>
  <joint name="beam_base_right_aft_joint" type="fixed">
    <parent link="base_link"/><child link="beam_base_right_aft"/>
    <origin xyz="-0.075 -0.1425 -0.015" rpy="0 0 0"/>
  </joint>

  <!-- Lower front cross (300 mm along Y); inner face at x=+0.100, outer at +0.115 -->
  <link name="beam_base_front">
    <visual>
      <!-- MakerBeam XL 15x15 T-slot profile, 299 mm (extruded along mesh X; cut ends = bare aluminium in viewer) -->
      <origin xyz="0 0 0" rpy="0 0 1.5707963267948966"/>
      <geometry><mesh filename="meshes/makerbeam_xl_299.stl?v=304" scale="1 1 1"/></geometry>
      <material name="beam_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.015 0.299 0.015"/></geometry>
    </collision>
    <inertial>
      <mass value="0.10"/><inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.0008"/>
    </inertial>
  </link>
  <joint name="beam_base_front_joint" type="fixed">
    <parent link="base_link"/><child link="beam_base_front"/>
    <origin xyz="0.1075 0.0 -0.015" rpy="0 0 0"/>
  </joint>

  <!-- XL corner cube ON TOP of the LEFT end of beam_base_front (y +/-149.5 end, top face z -0.0075): centre z 0, outer face flush with the beam end,
       inner face at |y| 134.5 = 0.5 mm outboard of the dustpan flap (|y| <= 134.0) over its full 0..3.0915 rad range; base min gap 3.9 mm. Helps hold the dustpan. v235 -->
  <link name="cube_front_left">
    <visual>
      <!-- MakerBeam XL corner cube 15 mm (meshes/gen_corner_cube.py), black anodised. Hole faces -> ON TOP of the left end of beam_base_front: -Z = T-nut in the beam top slot, -Y = inward toward the dustpan, +X forward -->
      <origin xyz="0 0 0" rpy="-1.570796 0.000000 -1.570796"/>
      <geometry><mesh filename="meshes/makerbeam_xl_corner_cube.stl?v=304" scale="1 1 1"/></geometry>
      <material name="beam_black"/>
    </visual>
    <inertial><mass value="0.0045"/><inertia ixx="1.7e-7" ixy="0" ixz="0" iyy="1.7e-7" iyz="0" izz="1.7e-7"/></inertial>
  </link>
  <joint name="cube_front_left_joint" type="fixed">
    <parent link="base_link"/><child link="cube_front_left"/>
    <origin xyz="0.1075 0.142 0.0" rpy="0 0 0"/>
  </joint>

  <!-- XL corner cube ON TOP of the RIGHT end of beam_base_front (y +/-149.5 end, top face z -0.0075): centre z 0, outer face flush with the beam end,
       inner face at |y| 134.5 = 0.5 mm outboard of the dustpan flap (|y| <= 134.0) over its full 0..3.0915 rad range; base min gap 3.9 mm. Helps hold the dustpan. v235 -->
  <link name="cube_front_right">
    <visual>
      <!-- MakerBeam XL corner cube 15 mm (meshes/gen_corner_cube.py), black anodised. Hole faces -> ON TOP of the right end of beam_base_front: -Z = T-nut in the beam top slot, +Y = inward toward the dustpan, +X forward -->
      <origin xyz="0 0 0" rpy="0.000000 1.570796 0.000000"/>
      <geometry><mesh filename="meshes/makerbeam_xl_corner_cube.stl?v=304" scale="1 1 1"/></geometry>
      <material name="beam_black"/>
    </visual>
    <inertial><mass value="0.0045"/><inertia ixx="1.7e-7" ixy="0" ixz="0" iyy="1.7e-7" iyz="0" izz="1.7e-7"/></inertial>
  </link>
  <joint name="cube_front_right_joint" type="fixed">
    <parent link="base_link"/><child link="cube_front_right"/>
    <origin xyz="0.1075 -0.142 0.0" rpy="0 0 0"/>
  </joint>




  <!-- ========== FRONT CASTER (primitives only — solid connected stack) ==========
       beam → T (flush) → plate (flush) → neck → U-fork hood → twin Ø1.5" wheels.
       No custom meshes. Tire on ground. -->
  <!-- v271: the old primitive front caster T was replaced by the 4-T assembly (bracket_4t_front_*, generated block at the end of the file) -->

  <!-- Caster mount plate (38 mm style) under stem, 20 mm forward of stem center toward beam -->
  <link name="front_caster_plate">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.038 0.038 0.0025"/></geometry>
      <material name="bracket_silver"/>
    </visual>
    <visual>
      <origin xyz="0.0125 0.0125 -0.0002" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0025" length="0.0029"/></geometry>
      <material name="mount_hole"/>
    </visual>
    <visual>
      <origin xyz="0.0125 -0.0125 -0.0002" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0025" length="0.0029"/></geometry>
      <material name="mount_hole"/>
    </visual>
    <visual>
      <origin xyz="-0.0125 0.0125 -0.0002" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0025" length="0.0029"/></geometry>
      <material name="mount_hole"/>
    </visual>
    <visual>
      <origin xyz="-0.0125 -0.0125 -0.0002" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0025" length="0.0029"/></geometry>
      <material name="mount_hole"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.0015" rpy="0 0 0"/>
      <geometry><cylinder radius="0.005" length="0.0008"/></geometry>
      <material name="bracket_silver"/>
    </visual>
    <visual>   <!-- v271 steel spacer ring 4 mm (OD 16, ID 10.4) between the centre-T stem and the caster plate (kingpin region) -->
      <origin xyz="0 0 0.00325" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/brackets/caster_shim.stl?v=304" scale="1 1 1"/></geometry>
      <material name="bolt_steel"/>
    </visual>
    <inertial><mass value="0.03"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="front_caster_plate_joint" type="fixed">
    <parent link="base_link"/><child link="front_caster_plate"/>
    <!-- v271: kingpin at x=0.0925 (centre-T 1/4 in hole, 15 mm in from the bar centre); plate top 2.5 mm under the binding T (z -0.028) so the 3 binding-screw heads clear it; 4 mm shim ring up to the centre T -->
    <origin xyz="0.09250 0 -0.02925" rpy="0 0 0"/>
  </joint>

  <!-- Single rotating assembly: neck + solid U-fork (all one link so nothing can float apart) -->
  <link name="front_caster_yaw">
    <!-- Hood shell mesh (unchanged shape); stem is a separate cylinder so it can be edited alone -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/front_caster_hood_v304.stl?v=304" scale="1 1 1"/></geometry>
      <material name="hs_black"/>
    </visual>
    <!-- Stem only: thinner + longer to meet hood (do not bake into hood mesh) -->
    <visual>   <!-- v304: neck 5 mm shorter (top stays in the shim, bottom moves up with the hood) -->
      <origin xyz="0 0 -0.01700" rpy="0 0 0"/>
      <geometry><cylinder radius="0.005" length="0.03400"/></geometry>
      <material name="hs_black"/>
    </visual>
    <collision>
      <origin xyz="-0.01700 0 -0.03595" rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.02305" length="0.03050"/></geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <origin xyz="-0.01700 0 -0.01079"/>
      <inertia ixx="2e-5" ixy="0" ixz="0" iyy="2e-5" iyz="0" izz="1.5e-5"/>
    </inertial>
  </link>
  <joint name="front_caster_yaw_joint" type="continuous">
    <parent link="front_caster_plate"/>
    <child link="front_caster_yaw"/>
    <origin xyz="0 0 -0.01060" rpy="0 0 0"/>   <!-- v308: -14.35 mm caster spacer for soft tire (loaded R 0.100). v304 (James): whole rolling caster raised 5 mm (was -0.00125); on hard floor the twin wheels sit 5.2 mm above the floor and only touch on hard braking / downhill -->
    <axis xyz="0 0 1"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>

  <link name="front_caster_wheels">
    <!-- Same material as hood; stick out slightly past hood; axle not shown -->
    <visual>
      <origin xyz="0 0.00825 0" rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.01905" length="0.01400"/></geometry>
      <material name="hs_black"/>
    </visual>
    <visual>
      <origin xyz="0 -0.00825 0" rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.01905" length="0.01400"/></geometry>
      <material name="hs_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.01905" length="0.03050"/></geometry>
    </collision>
    <inertial>
      <mass value="0.06"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="2e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="front_caster_wheel_joint" type="continuous">
    <parent link="front_caster_yaw"/>
    <child link="front_caster_wheels"/>
    <origin xyz="-0.01700 0 -0.03595" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.02" friction="0.01"/>
  </joint>




  <!-- Lower rear cross; inner face at x=-0.150, outer at -0.165 -->
  <link name="beam_base_rear">
    <visual>
      <!-- MakerBeam XL 15x15 T-slot profile, 299 mm (extruded along mesh X; cut ends = bare aluminium in viewer) -->
      <origin xyz="0 0 0" rpy="0 0 1.5707963267948966"/>
      <geometry><mesh filename="meshes/makerbeam_xl_299.stl?v=304" scale="1 1 1"/></geometry>
      <material name="beam_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.015 0.299 0.015"/></geometry>
    </collision>
    <inertial>
      <mass value="0.10"/><inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.0008"/>
    </inertial>
  </link>
  <joint name="beam_base_rear_joint" type="fixed">
    <parent link="base_link"/><child link="beam_base_rear"/>
