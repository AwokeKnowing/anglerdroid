  <!-- ODrive shop USB-CAN Adapter (CANable-class), centered on starboard odrive_right aft/cover face.
       Product: https://shop.odriverobotics.com/products/usb-can-adapter
       Datasheet mech (with case): Width 36.14 × Length 40.16 × Height 13.65 mm
         https://docs.odriverobotics.com/v/latest/hardware/usb-can-datasheet.html
       Layout from shop pinout photo: USB-C on one short end, green 4-pos screw terminal on opposite,
       optional JST-GH + status LEDs under clear acrylic top / black base sandwich.
       Local before joint yaw: X=width, Y=length (green at +Y), Z=height (out of cover).
       Joint yaw −90° points green down (world −Z). Bottom on cover outer face z=0.025. -->
  <link name="canable">
    <!-- black case base (full footprint) -->
    <visual>
      <origin xyz="0 0 -0.0020" rpy="0 0 0"/>
      <geometry><box size="0.03614 0.04016 0.00965"/></geometry>
      <material name="canable_case"/>
    </visual>
    <!-- clear acrylic top plate -->
    <visual>
      <origin xyz="0 0 0.005325" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/canable_clear_top.stl" scale="1 1 1"/></geometry>
      <material name="canable_clear"/>
    </visual>
    <!-- dark PCB slab visible under clear -->
    <visual>
      <origin xyz="0 0 0.0025" rpy="0 0 0"/>
      <geometry><box size="0.032 0.034 0.0016"/></geometry>
      <material name="odrive_board"/>
    </visual>
    <!-- green 4-pos CAN screw terminal (+Y end of length) -->
    <visual>
      <origin xyz="0 0.0155 0.0045" rpy="0 0 0"/>
      <geometry><box size="0.020 0.0085 0.010"/></geometry>
      <material name="odrive_term"/>
    </visual>
    <!-- USB-C receptacle (−Y end); silver shell ~9×7×3.5 mm class -->
    <visual>
      <origin xyz="0 -0.0215 0.0005" rpy="0 0 0"/>
      <geometry><box size="0.0090 0.0070 0.0035"/></geometry>
      <material name="canable_usb"/>
    </visual>
    <!-- white JST-GH 4-pos (near terminal, under clear) -->
    <visual>
      <origin xyz="0.008 0.006 0.0040" rpy="0 0 0"/>
      <geometry><box size="0.006 0.0045 0.004"/></geometry>
      <material name="odrive_white"/>
    </visual>
    <!-- status LED (TX/RX proxy) -->
    <visual>
      <origin xyz="-0.010 -0.008 0.0042" rpy="0 0 0"/>
      <geometry><box size="0.0025 0.0015 0.0012"/></geometry>
      <material name="led_green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.03614 0.04016 0.01365"/></geometry>
    </collision>
    <inertial>
      <mass value="0.012"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.000002" ixy="0" ixz="0" iyy="0.000002" iyz="0" izz="0.000003"/>
    </inertial>
  </link>
  <joint name="canable_joint" type="fixed">
    <parent link="odrive_right"/><child link="canable"/>
    <!-- Cover outer face at local z=0.025; CANable half-height 0.006825 → center 0.031825.
         Yaw −π/2: green screw terminal (+Y in canable) → odrive +X → world −Z (down). -->
    <origin xyz="0 0 0.031825" rpy="0 0 -1.5707963267948966"/>
  </joint>





