  <!-- D435i BMI055/BMI085 IMU — nominal extrinsics from realsense2_description
       _d435i_imu_modules.urdf.xacro (camera_link/depth_frame → IMU).
       Mesh origin is housing geometric center; camera_link is +17.5 mm in Y (left IR).
       IMU mesh pose = (-0.01174, 0.01198, 0.0051). Orientation matches camera body (REP-103).
       Chain base_link → realsense_d435i → realsense_d435i_imu gives IMU↔base extrinsics. -->
  <link name="realsense_d435i_imu">
    <!-- Chip body (oriented object at true IMU) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.004 0.004 0.0015"/></geometry>
      <material name="rs_imu_badge"/>
    </visual>
    <!-- Axis triad so orientation is visible (+X fwd red-ish dark, +Y left, +Z up) -->
    <visual>
      <origin xyz="0.004 0 0" rpy="0 1.5707963267948966 0"/>
      <geometry><cylinder radius="0.0004" length="0.008"/></geometry>
      <material name="estop_red"/>
    </visual>
    <visual>
      <origin xyz="0 0.004 0" rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.0004" length="0.008"/></geometry>
      <material name="seeed_green"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.004" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0004" length="0.008"/></geometry>
      <material name="rs_imu_badge"/>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
    </inertial>
  </link>
  <joint name="realsense_d435i_imu_joint" type="fixed">
    <parent link="realsense_d435i"/><child link="realsense_d435i_imu"/>
    <origin xyz="-0.01174000 0.01198000 0.00510000" rpy="0 0 0"/>
  </joint>
  <!-- Optical convention (OpenCV / RealSense SDK): +X right, +Y down, +Z forward -->
  <link name="realsense_d435i_imu_optical"/>
  <joint name="realsense_d435i_imu_optical_joint" type="fixed">
    <parent link="realsense_d435i_imu"/><child link="realsense_d435i_imu_optical"/>
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
  </joint>

  <!-- ========== USB16MP01 RGB board camera (tip of beam_mast_top) ==========
       32×32×1.6 mm PCB; lens stack ~25 mm PCB-front→glass; plastic velcro to tip face.
       Board vertical (YZ), lens +X; connector on PCB back at top. Sits on D435 top overhang.
       Photos: meshes/ref/rgb_cam_*.jpg -->
  <link name="rgb_camera">
    <!-- Plastic velcro pad: 2.5 mm thick, 25 mm L-R × 15 mm tall (matches tip-face
         height so it does not poke into D435 below); JST at PCB top-back stays clear -->
    <visual>
      <origin xyz="-0.00205 0 -0.0085" rpy="0 0 0"/>
      <geometry><box size="0.0025 0.025 0.015"/></geometry>
      <material name="velcro_black"/>
    </visual>
    <!-- PCB 32×32×1.6 mm (X = thickness) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.0016 0.032 0.032"/></geometry>
      <material name="pcb_brown"/>
    </visual>
    <!-- Corner mounting holes Ø2 mm, ~2.5 mm in from edges -->
    <visual>
      <origin xyz="0 0.0135 0.0135" rpy="0 1.5707963267948966 0"/>
      <geometry><cylinder radius="0.001" length="0.0018"/></geometry>
      <material name="mount_hole"/>
    </visual>
    <visual>
      <origin xyz="0 -0.0135 0.0135" rpy="0 1.5707963267948966 0"/>
      <geometry><cylinder radius="0.001" length="0.0018"/></geometry>
      <material name="mount_hole"/>
    </visual>
    <visual>
      <origin xyz="0 0.0135 -0.0135" rpy="0 1.5707963267948966 0"/>
      <geometry><cylinder radius="0.001" length="0.0018"/></geometry>
      <material name="mount_hole"/>
    </visual>
    <visual>
      <origin xyz="0 -0.0135 -0.0135" rpy="0 1.5707963267948966 0"/>
      <geometry><cylinder radius="0.001" length="0.0018"/></geometry>
      <material name="mount_hole"/>
    </visual>
    <!-- Black square lens holder ~20×20×8.5 mm -->
    <visual>
      <origin xyz="0.00505 0 -0.004" rpy="0 0 0"/>
      <geometry><box size="0.0085 0.020 0.020"/></geometry>
      <material name="lens_black"/>
    </visual>
    <!-- Side ear tabs (mount screws) L/R -->
    <visual>
      <origin xyz="0.00505 0.0125 -0.004" rpy="0 0 0"/>
      <geometry><box size="0.0085 0.005 0.006"/></geometry>
      <material name="lens_black"/>
    </visual>
    <visual>
      <origin xyz="0.00505 -0.0125 -0.004" rpy="0 0 0"/>
      <geometry><box size="0.0085 0.005 0.006"/></geometry>
      <material name="lens_black"/>
    </visual>
    <!-- Ribbed/knurled barrel Ø14 × 10 mm (smooth cylinder stand-in) -->
    <visual>
      <origin xyz="0.0143 0 -0.004" rpy="0 1.5707963267948966 0"/>
      <geometry><cylinder radius="0.007" length="0.010"/></geometry>
      <material name="lens_black"/>
    </visual>
    <!-- Wider lens front/cap Ø16.5 × 6.5 mm -->
    <visual>
      <origin xyz="0.02255 0 -0.004" rpy="0 1.5707963267948966 0"/>
      <geometry><cylinder radius="0.00825" length="0.0065"/></geometry>
      <material name="lens_black"/>
    </visual>
    <!-- Glass (dark purple-ish) at lens front -->
    <visual>
      <origin xyz="0.0254 0 -0.004" rpy="0 1.5707963267948966 0"/>
      <geometry><cylinder radius="0.007" length="0.0008"/></geometry>
      <material name="lens_glass"/>
    </visual>
    <!-- White 4-pin JST-style connector on PCB BACK at TOP edge -->
    <visual>
      <origin xyz="-0.0038 -0.006 0.012" rpy="0 0 0"/>
      <geometry><box size="0.006 0.010 0.0055"/></geometry>
      <material name="jst_white"/>
    </visual>
    <collision>
      <origin xyz="0.012 0 0" rpy="0 0 0"/>
      <geometry><box size="0.028 0.032 0.032"/></geometry>
    </collision>
    <inertial>
      <mass value="0.012"/>
      <origin xyz="0.008 0 0"/>
      <inertia ixx="2e-6" ixy="0" ixz="0" iyy="3e-6" iyz="0" izz="3e-6"/>
    </inertial>
  </link>
  <joint name="rgb_camera_joint" type="fixed">
    <parent link="beam_mast_top"/><child link="rgb_camera"/>
    <!-- Tip face of 150 mm top bar at world x=0; velcro 2.5 mm then PCB.
         PCB bottom flush with D435 top / beam underside (z=0.8775).
         Relative to beam_mast_top center (-0.075, 0, 0.885). -->
    <origin xyz="0.0783 0 0.0085" rpy="0 0 0"/>
  </joint>
  <!-- Optical frame at lens front: +Z out of lens (+X robot), +X right, +Y down -->
  <link name="rgb_camera_optical"/>
  <joint name="rgb_camera_optical_joint" type="fixed">
    <parent link="rgb_camera"/><child link="rgb_camera_optical"/>
    <origin xyz="0.0258 0 -0.004" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
  </joint>

</robot>
