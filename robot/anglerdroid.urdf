<?xml version="1.0"?>
<robot name="anglerdroid">
  <link name="base_link">
    <!-- Trapezoidal body (STL mesh, origin already at axle centre) -->
    <visual name="body">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/body.stl"/></geometry>
      <material name="body_mat"><color rgba="0.18 0.18 0.20 1"/></material>
    </visual>

    <!-- Left wheel -->
    <visual name="wheel_left">
      <origin xyz="0.0000 -0.1770 0.0000" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0825" length="0.0500"/></geometry>
      <material name="wheel_left_mat"><color rgba="0.09 0.09 0.10 1"/></material>
    </visual>

    <!-- Right wheel -->
    <visual name="wheel_right">
      <origin xyz="0.0000 0.1770 0.0000" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0825" length="0.0500"/></geometry>
      <material name="wheel_right_mat"><color rgba="0.09 0.09 0.10 1"/></material>
    </visual>

    <!-- Caster -->
    <visual name="caster">
      <origin xyz="-0.1900 0.0000 -0.0650" rpy="0 0 0"/>
      <geometry><box size="0.0200 0.0800 0.0400"/></geometry>
      <material name="caster_mat"><color rgba="0.16 0.16 0.18 1"/></material>
    </visual>

    <!-- Mast -->
    <visual name="mast">
      <origin xyz="-0.1650 0.0000 0.5250" rpy="0 0 0"/>
      <geometry><box size="0.0300 0.0300 0.7800"/></geometry>
      <material name="mast_mat"><color rgba="0.40 0.42 0.45 1"/></material>
    </visual>

    <!-- Camera arm -->
    <visual name="camera_arm">
      <origin xyz="-0.0675 0.0000 0.9000" rpy="0 0 0"/>
      <geometry><box size="0.1650 0.0300 0.0300"/></geometry>
      <material name="camera_arm_mat"><color rgba="0.34 0.36 0.40 1"/></material>
    </visual>

    <!-- RS1 top-down camera -->
    <visual name="rs1_topdown">
      <origin xyz="-0.0050 0.0000 0.9275" rpy="0 0 0"/>
      <geometry><box size="0.0900 0.0800 0.0250"/></geometry>
      <material name="rs1_topdown_mat"><color rgba="0.12 0.22 0.32 1"/></material>
    </visual>

    <!-- RS2 forward camera -->
    <visual name="rs2_forward">
      <origin xyz="0.0325 0.0000 0.8700" rpy="0 0 0"/>
      <geometry><box size="0.0350 0.0600 0.0300"/></geometry>
      <material name="rs2_forward_mat"><color rgba="0.12 0.22 0.32 1"/></material>
    </visual>

    <!-- Jetson NX -->
    <visual name="jetson_nx">
      <origin xyz="-0.1200 0.0000 0.1475" rpy="0 0 0"/>
      <geometry><box size="0.1000 0.0800 0.0250"/></geometry>
      <material name="jetson_nx_mat"><color rgba="0.16 0.22 0.16 1"/></material>
    </visual>

    <!-- Base footprint (ground reference, transparent) -->
    <visual name="footprint">
      <origin xyz="0.0000 0.0000 -0.0840" rpy="0 0 0"/>
      <geometry><box size="0.3800 0.4540 0.0020"/></geometry>
      <material name="footprint_mat"><color rgba="0.5 0.5 0.5 0.2"/></material>
    </visual>

    <collision name="body_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/body.stl"/></geometry>
    </collision>
  </link>
</robot>
